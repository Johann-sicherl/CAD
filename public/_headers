# Cabeçalhos do Cloudflare Pages.
# COOP + COEP isolam a origem (window.crossOriginIsolated = true), o que libera o
# SharedArrayBuffer: requisito do kernel OpenCascade com várias threads.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff

# service worker e página sempre conferidos (atualização do app instalado)
/sw.js
  Cache-Control: no-cache
/precache.json
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/cad/
  Cache-Control: no-cache
/cad/index.html
  Cache-Control: no-cache

# arquivos com hash no nome nunca mudam
/assets/*
  Cache-Control: public, max-age=31536000, immutable
